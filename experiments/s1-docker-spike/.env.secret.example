# S1 스파이크 환경변수 — 복사: cp .env.secret.example .env.secret  (.env.secret은 gitignore)
# 운영(argocd)에선 vault agent가 .env.secret 을 주입한다. 로컬 개발도 동일하게 .env.secret 하나만 쓴다.
# run-spike.sh 가 이 파일을 source 해서 docker compose 로 넘긴다.

# ── 시크릿 (vault가 주입하는 값) ─────────────────────────────────────────────
# 진짜 Anthropic API key — LiteLLM 게이트웨이(proxy)에만 보관된다. 학생 컨테이너엔 절대 안 들어감(필수).
# Anthropic Console(platform.claude.com)에서 발급. 조직 tier가 50명 동시의 rate limit 천장.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# LiteLLM 관리자 키 — 가상키 발급(/key/generate)에 쓰임. 아무 'sk-' 문자열로 충분(로컬).
LITELLM_MASTER_KEY=sk-master-change-me

# ── 런타임 설정 (비밀 아님; 필요 시 override) ────────────────────────────────
# 이 attempt(=학생) 식별자. runtime/<ATTEMPT_ID>/ 아래에 홈이 격리된다.
ATTEMPT_ID=spike-1

# 주입할 문제. problem-registry/<PROBLEM_ID>/scaffold 가 /workspace에 시드된다.
# 이 값만 바꿔 재기동하면 "다른 문제가 들어와 있음"을 확인할 수 있다(§12 성공 기준).
PROBLEM_ID=ainc2026

# code-server를 노출할 호스트 포트. 동시에 여러 학생을 띄울 땐 학생마다 다르게.
EXAM_PORT=8080
