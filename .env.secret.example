# CatchUP — 단일 시크릿 소스(.env.secret). 이 파일 하나만 채우면 setup.sh 가 클러스터까지 전파한다.
#   cp .env.secret.example .env.secret  후 값 채우기 → ./setup.sh
# gitignore 됨(절대 커밋 금지). docs/6 §0.5: 로컬은 평문 .env.secret, alpha/prod 는 SealedSecrets 가 이 자리를 대신.
#
# setup.sh 가 .env.secret 을 읽어 클러스터 Secret 2개를 렌더한다(git 에는 값 없음 → ArgoCD selfHeal 무관):
#   app-secrets      ← web·postgres·minio pod        litellm-secrets ← litellm pod(ANTHROPIC 포함)
# postgres/minio pod 도 아래 값을 secretKeyRef 로 읽으므로, 여기가 진짜 단일 소스다.

# ── 1) LLM (유일한 외부 실키) ───────────────────────────────────────────────
# Anthropic Console(https://console.anthropic.com) → API Keys 에서 발급. litellm 게이트웨이가 보관·중계.
# 비워두면 게이트웨이는 뜨지만 실제 LLM 호출은 실패. 채운 뒤 ./setup.sh --no-build 재실행하면 주입됨.
ANTHROPIC_API_KEY=
# 게이트웨이 마스터키(가상키 발급·관리·web→litellm 인증). 로컬은 아무 값, 운영은 강한 무작위값.
LITELLM_MASTER_KEY=sk-master-dev

# ── 2) 앱 시크릿 (비우면 setup.sh 가 무작위 생성해 채움) ─────────────────────
# ⚠️ 값 뒤에 인라인 주석(KEY=v # ...) 금지 — 주석이 값으로 섞여 시크릿이 깨진다. 주석은 항상 별도 줄.
# SESSION_SECRET: 쿠키 HMAC 서명
SESSION_SECRET=
# INTERNAL_API_SECRET: 내부 라우트(pod↔web: 슬롯 register/heartbeat·문제 업로드) 인증
INTERNAL_API_SECRET=
# ArgoCD UI 로그인 암호(계정명은 항상 admin). 비우면 ArgoCD 자동생성 암호 사용.
ARGOCD_ADMIN_PASSWORD=

# ── 3) DB (postgres) — 로컬 고정 기본값. 바꾸면 postgres PVC 를 비워야 반영됨 ──
POSTGRES_USER=catchup
POSTGRES_PASSWORD=catchup
POSTGRES_DB=catchup

# ── 4) 객체 스토리지 (MinIO) — 로컬 고정 기본값 ─────────────────────────────
MINIO_ROOT_USER=catchup
MINIO_ROOT_PASSWORD=catchup-minio

# ── 5) 호스트 dev 전용(pnpm dev 로 직접 구동할 때만; 클러스터는 setup.sh 가 자동 구성) ──
# 클러스터 안에선 host=postgres/redis/minio(서비스명), 호스트 dev 에선 localhost(+port-forward).
# 아래는 'pnpm dev' 용이며 위 3·4 자격증명과 일치해야 한다.
DATABASE_URL=postgres://catchup:catchup@localhost:5433/catchup
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=catchup
MINIO_SECRET_KEY=catchup-minio
LITELLM_BASE_URL=http://localhost:4000
