# 로컬 개발 환경변수 템플릿(이 파일만 커밋). 복사: cp .env.secret.example .env.secret
# 실제 시크릿은 .env.secret 에 담는다(gitignore 처리됨 — 절대 커밋 금지).
# docker-compose.yml 의 기본 자격증명과 일치한다(그대로 쓰면 동작).

# 단일 PostgreSQL — 정보원(source of truth). 마이그레이션 러너와 앱이 공유.
# 포트 5433: 다른 프로젝트 postgres(5432)와 충돌 회피(docker-compose 기본값과 일치).
DATABASE_URL=postgres://catchup:catchup@localhost:5433/catchup

# 단일 Redis — 캐시/세션/카운터/잡락. fail-soft(없어도 앱은 동작, 느려질 뿐).
REDIS_URL=redis://localhost:6379

# 단일 MinIO — 객체 스토리지(제출 산출물·대화로그). docs/5 §2. 버킷은 setup.sh가 생성(앱 첫 put도 자동).
# 기본값은 docker-compose minio 서비스(ROOT_USER/PASSWORD)와 일치. prod는 전부 override.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=catchup
MINIO_SECRET_KEY=catchup-minio

# ── LiteLLM 게이트웨이(상주 공용; docs/3 §2) — 가상키 발급·spend·"*"→Sonnet 강제 ──
# 기본 스택엔 안 뜬다. 게이트웨이를 쓰려면: docker compose --profile gateway up -d (진짜 키 필요).
# 진짜 Anthropic 키는 게이트웨이에만 보관(학생/앱엔 가상키만). 로컬 전용 — git 평문 금지.
ANTHROPIC_API_KEY=
# 가상키 발급용 관리자 키(앱의 /key/generate·/key/info 호출 + 게이트웨이 master). compose 기본값과 일치.
LITELLM_MASTER_KEY=sk-master-dev
# 앱(호스트)에서 게이트웨이 접근 주소. 컨테이너 내부 DATABASE_URL은 compose가 자동 주입(litellm 전용 DB).
LITELLM_BASE_URL=http://localhost:4000

# 선택: pg 풀 최대 커넥션(reference/09). 기본 10.
# DB_POOL_MAX=10

# docker-compose 오버라이드(선택) — 기본값과 같으면 생략 가능.
# POSTGRES_USER=catchup
# POSTGRES_PASSWORD=catchup
# POSTGRES_DB=catchup
# POSTGRES_PORT=5433
# REDIS_PORT=6379

# 세션 쿠키 HMAC 서명 키(위조 방지). production 필수. 임의의 긴 랜덤 문자열.
SESSION_SECRET=dev-insecure-session-secret-do-not-use-in-prod
