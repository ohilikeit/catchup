# 로컬 개발 환경변수 템플릿(이 파일만 커밋). 복사: cp .env.example .env.secret
# 실제 시크릿은 .env.secret 에 담는다(gitignore 처리됨 — 절대 커밋 금지).
# docker-compose.yml 의 기본 자격증명과 일치한다(그대로 쓰면 동작).

# 단일 PostgreSQL — 정보원(source of truth). 마이그레이션 러너와 앱이 공유.
# 포트 5433: 다른 프로젝트 postgres(5432)와 충돌 회피(docker-compose 기본값과 일치).
DATABASE_URL=postgres://catchup:catchup@localhost:5433/catchup

# 단일 Redis — 캐시/세션/카운터/잡락. fail-soft(없어도 앱은 동작, 느려질 뿐).
REDIS_URL=redis://localhost:6379

# 선택: pg 풀 최대 커넥션(reference/09). 기본 10.
# DB_POOL_MAX=10

# docker-compose 오버라이드(선택) — 기본값과 같으면 생략 가능.
# POSTGRES_USER=catchup
# POSTGRES_PASSWORD=catchup
# POSTGRES_DB=catchup
# POSTGRES_PORT=5433
# REDIS_PORT=6379
